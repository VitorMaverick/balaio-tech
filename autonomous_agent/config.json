{
  "project": "balaio-tech",
  "port": 3000,
  "healthEndpoint": "http://localhost:3000/api/categories",
  "restartCommand": "npm run start",
  "uploadsPath": "public/uploads",
  "databasePath": "database.db",
  "logFiles": ["logs/error.log", "logs/out.log"],
  "maxRestartAttempts": 3,
  "knownErrors": [
    { "pattern": "EADDRINUSE", "action": "killPort" },
    { "pattern": "Cannot find module", "action": "npmInstall" },
    { "pattern": "SQLITE_CORRUPT", "action": "restoreDb" },
    { "pattern": "ENOENT.*uploads", "action": "ensureUploads" },
    { "pattern": "ENOMEM", "action": "restart" }
  ],
